---
interface Props {
  title: string;
  date: string;
  video?: string;
  image?: string;
  excerpt?: string;
}
const { title, date, video, image, excerpt } = Astro.props;
---
<article style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: all 0.2s;">
  {video && (
    <div style="aspect-ratio: 9/16; max-height: 400px; overflow: hidden;">
      <video src={video} poster={image} style="width: 100%; height: 100%; object-fit: cover;" muted loop preload="metadata" />
    </div>
  )}
  {!video && image && (
    <div style="aspect-ratio: 16/9; overflow: hidden;">
      <img src={image} alt={title} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
    </div>
  )}
  <div style="padding: 1.25rem;">
    <time style="font-size: 0.8rem; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">{date}</time>
    <h3 style="margin: 0.5rem 0; font-size: 1.1rem; font-weight: 600; line-height: 1.3;">{title}</h3>
    {excerpt && <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5;">{excerpt}</p>}
  </div>
</article>
